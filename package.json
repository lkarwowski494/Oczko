{
  "name": "oczko",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "description": "Oczko (Purlo) — Apps4Brew",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage --forceExit",
    "test:pbt": "jest --testPathPattern=property-based --forceExit",
    "test:perf": "jest --testPathPattern=perf-budget --forceExit",
    "test:a11y": "jest --testPathPattern=a11y-contracts --forceExit",
    "test:resilience": "jest --testPathPattern=resilience --forceExit",
    "test:concurrency": "jest --testPathPattern=concurrency --forceExit",
    "test:corpus": "jest --testPathPattern=gauge-corpus --forceExit",
    "check:corpus": "python scripts/gen-gauge-corpus.py",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:licenses": "node scripts/licenses.mjs --check",
    "verify": "npm run typecheck && npm run check:i18n && npm run check:licenses && node scripts/test-matrix.mjs --check && node scripts/verify-native.mjs && npm run test:coverage"
  },
  "dependencies": {
    "@formatjs/intl-locale": "5.3.12",
    "@formatjs/intl-pluralrules": "6.3.15",
    "@types/qrcode": "^1.5.6",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-document-picker": "^57.0.3",
    "expo-haptics": "^57.0.3",
    "expo-linking": "~57.0.11",
    "expo-localization": "57.0.2",
    "expo-router": "~57.0.24",
    "expo-sqlite": "~57.0.3",
    "i18next": "26.4.2",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-i18next": "17.0.16",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@react-native/jest-preset": "^0.86.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "@types/react-test-renderer": "^19.3.0",
    "babel-preset-expo": "~57.0.0",
    "fast-check": "^4.10.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.5.4"
  }
}
