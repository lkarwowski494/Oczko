{
  "name": "oczko",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "description": "Oczko (Purlo) — Apps4Brew",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage --forceExit",
    "test:pbt": "jest --testPathPattern=property-based --forceExit",
    "test:perf": "jest --testPathPattern=perf-budget --forceExit",
    "test:a11y": "jest --testPathPattern=a11y-contracts --forceExit",
    "test:resilience": "jest --testPathPattern=resilience --forceExit",
    "test:concurrency": "jest --testPathPattern=concurrency --forceExit",
    "test:corpus": "jest --testPathPattern=gauge-corpus --forceExit",
    "check:corpus": "python scripts/gen-gauge-corpus.py",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:licenses": "node scripts/licenses.mjs --check",
    "verify": "npm run typecheck && npm run typecheck:testy && npm run lint && npm run jakosc:kontrole && npm test",
    "i18n": "node scripts/sprawdz-i18n.mjs src/i18n/slowniki --zrodlo en",
    "i18n:kod": "node scripts/sprawdz-i18n.mjs src/i18n/slowniki --zrodlo en --kod src/ekrany,src/komponenty,app",
    "i18n:pseudo": "node scripts/sprawdz-i18n.mjs src/i18n/slowniki --zrodlo en --pseudo src/i18n/pseudo/en-XA.json",
    "verify:stary": "npm run typecheck && npm run check:i18n && npm run check:licenses && node scripts/test-matrix.mjs --check && node scripts/verify-native.mjs && npm run test:coverage",
    "lint": "eslint src/dane",
    "test:akceptacja": "node scripts/jakosc/akceptacja-raport.mjs --wynik docs/jakosc/e3/akceptacja-wynik.md",
    "jakosc:kontrole": "node scripts/jakosc/kontrole-repo.mjs && node scripts/jakosc/sprawdz-workflowy.mjs && node --no-warnings docs/architektura/narzedzia/sprawdz-schemat.mjs && node docs/architektura/narzedzia/kontrola-negatywna/mutanty-schematu.mjs && node docs/architektura/narzedzia/sprawdz-porty.mjs && node docs/monetyzacja/limit-test.mjs && node docs/monetyzacja/dostep-test.mjs && node docs/architektura/eksperymenty/e1/scal-test.mjs && node docs/architektura/eksperymenty/e1/mutanty-scal.mjs && node docs/architektura/eksperymenty/e1/kontrola-adr.mjs docs/adr && npm run -s i18n",
    "jakosc:info": "node docs/architektura/narzedzia/granice.mjs src; npm run -s i18n:kod; exit 0",
    "typecheck:testy": "tsc -p tsconfig.testy.json"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-document-picker": "^57.0.3",
    "expo-haptics": "^57.0.3",
    "expo-linking": "~57.0.11",
    "expo-localization": "57.0.2",
    "expo-router": "~57.0.24",
    "expo-sqlite": "~57.0.3",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "@types/react-test-renderer": "^19.3.0",
    "@typescript-eslint/parser": "8.71.1",
    "babel-preset-expo": "~57.0.0",
    "eslint": "10.12.0",
    "fast-check": "^4.10.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.5.4",
    "yaml": "2.9.1"
  }
}
