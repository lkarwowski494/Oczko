{
  "expo": {
    "name": "Oczko",
    "slug": "oczko",
    "version": "0.1.0",
    "scheme": "oczko",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "description": "Oczko (Purlo) — asystent dziewiarstwa i szydełkowania. Liczniki rzędów, wzory PDF, baza włóczek i drutów. 100% Offline-First.",
    "primaryColor": "#C85A32",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF8F5",
      "dark": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#1A1A1A"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.apps4brew.knitting",
      "deploymentTarget": "18.0",
      "appleTeamId": "8NQ9GHY8GF",
      "buildNumber": "1",
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["DDA9.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1"]
          }
        ]
      },
      "infoPlist": {
        "UIRequiresFullScreen": true,
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": ["en"],
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleDisplayName": "Oczko",
        "NSSupportsLiveActivities": true
      }
    },
    "android": {
      "package": "com.apps4brew.knitting",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF8F5"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@bacons/apple-targets",
      "expo-iap",
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": { "ios": ["en"], "android": ["en"] },
          "supportsRTL": false
        }
      ]
    ],
    "locales": {
      "en": "./locales/systemowe/en.json"
    }
  }
}
