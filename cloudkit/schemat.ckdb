DEFINE SCHEMA

    RECORD TYPE Plik (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        sha256          STRING,
        rozszerzenie    STRING,
        bajty           INT64,
        utworzono_ms    INT64,
        dane            ASSET,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Projekt (
        "___createTime"   TIMESTAMP,
        "___createdBy"    REFERENCE,
        "___etag"         STRING,
        "___modTime"      TIMESTAMP,
        "___modifiedBy"   REFERENCE,
        "___recordID"     REFERENCE QUERYABLE,
        id                STRING,
        nazwa             STRING,
        nienazwany        INT64,
        stan              STRING,
        notatka           STRING,
        drut_mm           DOUBLE,
        narzedzie         STRING,
        film_adres        STRING,
        film_nazwa        STRING,
        probka            STRING,
        termin_dzien      STRING,
        kopia_z           STRING,
        utworzono_ms      INT64,
        zmieniono_ms      INT64,
        ostatnia_praca_ms INT64,
        ukonczono_ms      INT64,
        ukonczono_dzien   STRING,
        usunieto_ms       INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Czesc (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
